{
  "name": "@pidesk/desktop",
  "private": true,
  "version": "0.0.1",
  "description": "PiDesk 桌面应用（Electron main/preload/renderer）",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --win",
    "package:dir": "electron-vite build && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@pidesk/engine": "workspace:*",
    "@pidesk/ipc-schema": "workspace:*",
    "@pidesk/ui-kit": "workspace:*",
    "@tanstack/react-virtual": "^3.14.10",
    "@uiw/react-codemirror": "^4.25.11",
    "diff": "^9.0.0",
    "dockview": "^8.2.0",
    "ignore": "^7.0.6",
    "react-resizable-panels": "^4.12.3",
    "streamdown": "^2.6.0",
    "typebox": "^1.3.20",
    "zod": "^3.24.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.10.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
