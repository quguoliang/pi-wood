{
  "name": "@pi-wood/desktop",
  "private": true,
  "version": "0.0.1",
  "description": "pi-wood 桌面应用（Electron main/preload/renderer）",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node ../../scripts/ensure-electron.mjs && electron-vite dev",
    "build": "node ../../scripts/ensure-electron.mjs && electron-vite build",
    "package": "node ../../scripts/ensure-electron.mjs && electron-vite build && electron-builder --win",
    "package:dir": "node ../../scripts/ensure-electron.mjs && electron-vite build && electron-builder --dir",
    "probe:plugins": "node ../../scripts/ensure-electron.mjs && electron-vite build && electron . --plugin-probe",
    "probe:goal": "node ../../scripts/ensure-electron.mjs && electron-vite build && electron . --goal-probe",
    "probe:memory": "node ../../scripts/ensure-electron.mjs && electron-vite build && electron . --memory-probe",
    "probe:engine-process": "node ../../scripts/ensure-electron.mjs && electron-vite build && electron . --engine-process-probe",
    "probe:engine-process:packaged": "release\\win-unpacked\\pi-wood.exe --engine-process-probe=packaged",
    "probe:conversation": "node ../../scripts/ensure-electron.mjs && electron-vite build && electron . --conversation-probe",
    "probe:conversation:packaged": "release\\win-unpacked\\pi-wood.exe --conversation-probe=packaged",
    "probe:worktree": "node electron/main/engine/worktree-probe.mjs",
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test electron/main/workbench/snapshot-service.test.ts electron/main/subagent/usage.test.ts electron/main/subagent/permissions.test.ts electron/main/security/approval-gate.test.ts electron/main/goal/goal-machine.test.ts electron/main/goal/goal-prompt.test.ts electron/main/review/parse-findings.test.ts electron/main/memory/store.test.ts electron/main/provider/model-pick.test.ts electron/main/provider/usage-core.test.ts electron/main/provider/usage-tracker.test.ts electron/main/engine/conversation-core.test.ts src/renderer/src/stores/conversation-slice.test.ts src/renderer/src/stores/session-store.test.ts src/renderer/src/lib/tool-groups.test.ts src/renderer/src/lib/theme-adapter.test.ts"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/merge": "^6.12.2",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@pi-wood/engine": "workspace:*",
    "@pi-wood/ipc-schema": "workspace:*",
    "@pi-wood/plugin-api": "workspace:*",
    "@pi-wood/ui-kit": "workspace:*",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-virtual": "^3.14.10",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "dockview": "^8.2.0",
    "ignore": "^7.0.6",
    "lucide-react": "^1.37.0",
    "playwright-core": "^1.62.1",
    "react-resizable-panels": "^4.12.3",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "typebox": "^1.3.20",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^3.24.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/diff": "^8.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.10.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
