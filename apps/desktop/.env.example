# pi-wood 本地密钥（此文件被 gitignore；仅主进程启动前注入 process.env，绝不外泄）
# 填法：复制为 .env 再填值；或优先用应用内「设置 → 密钥」写入系统钥匙串（safeStorage，更安全）。
# 两种通道等价：钥匙串按 provider id 注入 <ID>_API_KEY；.env 里直接写同名变量。

# ---- 模型 Provider（对话必需，二选一 provider 即可）----
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---- pi-web-access 联网搜索（可选；配一个 provider key 后 web_search 才有真实结果）----
# 默认 provider 可在 ~/.pi/web-search.json 里用 defaultProvider 指定。
# 下列任一即可，未配 key 时 web_search 会失败，但 fetch_content 免 key 可用。
EXA_API_KEY=
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# SERPER_API_KEY=
# ANYSEARCH_API_KEY=

# ---- pi-web-access 视频/音频理解（可选，需 Gemini）----
# GEMINI_API_KEY=
